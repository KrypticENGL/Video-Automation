# Copy to .env and fill in. Never commit .env.

PORT=4000
LOG_LEVEL=info

# Local dev (docker compose up -d) or a MongoDB Atlas URI
MONGO_URI=mongodb://127.0.0.1:27017/reels

# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Used only by `npm run seed` to create (or reset the password of) the client user
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
